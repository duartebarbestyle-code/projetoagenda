# Banco (Vercel > Storage > Neon Postgres)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=        # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail (Resend): código de login e avisos. Sem isso, aparece só no log.
# O domínio do EMAIL_FROM precisa estar verificado no Resend para enviar a qualquer endereço.
RESEND_API_KEY=
EMAIL_FROM=                # ex: Barbearia <nao-responda@seudominio.com>

# WhatsApp Cloud API (Meta): avisos a clientes e barbeiros. Sem isso, aparece só no log.
# Modelos de mensagem precisam estar aprovados (lista no README).
WHATSAPP_TOKEN=            # token de acesso permanente (usuário do sistema)
WHATSAPP_PHONE_ID=         # ID do número de telefone (não é o número)

# Lembretes
CRON_SECRET=               # Vercel envia automaticamente como Bearer
LEMBRETE_HORAS=24

# Vercel Blob (fotos e vídeos do portfólio, fotos dos profissionais)
BLOB_READ_WRITE_TOKEN=

# Só local: entra direto com esse usuário, sem tela de login (não vale em produção)
# DEV_LOGIN=
