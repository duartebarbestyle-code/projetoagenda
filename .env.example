# Banco (Vercel > Storage > Neon Postgres)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=        # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Twilio (SMS de código e lembretes). Sem isso, os SMS aparecem só no log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=               # número Twilio em E.164, ex: +15551234567

# Lembretes
CRON_SECRET=               # Vercel envia automaticamente como Bearer
LEMBRETE_HORAS=24

# E-mail (Resend) para recuperar acesso. Sem isso, aparece só no log.
RESEND_API_KEY=
EMAIL_FROM=                # ex: Barbearia <nao-responda@seudominio.com>

# WhatsApp dos barbeiros (Twilio). Número habilitado para WhatsApp, em E.164.
TWILIO_WHATSAPP_FROM=

# Vercel Blob (fotos e vídeos do portfólio)
BLOB_READ_WRITE_TOKEN=
